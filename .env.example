# Notion integrációs token (belső integráció, csak olvasás).
# Létrehozás: notion.so/profile/integrations -> New integration -> Read content
# Utána a 8 tárat meg kell osztani az integrációval (Connections menü).
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A Notion API verziója. A tudásbázis data source ID-kkel dolgozik (collection://...),
# ezekhez a 2025-09-03 vagy újabb verzió kell.
NOTION_VERSION=2025-09-03

# Hova írja a szinkron a verziózott pillanatképeket.
PILLANATKEP_DIR=./pillanatkepek
