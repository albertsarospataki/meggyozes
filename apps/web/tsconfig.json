{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@meggyozes/bemenet": [
        "../../packages/bemenet/src/index.ts"
      ],
      "@meggyozes/brand": [
        "../../packages/brand/src/index.ts"
      ],
      "@meggyozes/core": [
        "../../packages/core/src/index.ts"
      ],
      "@meggyozes/folyamat": [
        "../../packages/folyamat/src/index.ts"
      ],
      "@meggyozes/kalibracio": [
        "../../packages/kalibracio/src/index.ts"
      ],
      "@meggyozes/kerdezz": [
        "../../packages/kerdezz/src/index.ts"
      ],
      "@meggyozes/motor": [
        "../../packages/motor/src/index.ts"
      ],
      "@meggyozes/projekt": [
        "../../packages/projekt/src/index.ts"
      ],
      "@meggyozes/szervezet": [
        "../../packages/szervezet/src/index.ts"
      ],
      "@meggyozes/tanacs": [
        "../../packages/tanacs/src/index.ts"
      ],
      "@meggyozes/tanulas": [
        "../../packages/tanulas/src/index.ts"
      ],
      "@meggyozes/tarolas": [
        "../../packages/tarolas/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
